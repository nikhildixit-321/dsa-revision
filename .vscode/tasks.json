{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "DSA: Run with input.txt",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\run-dsa.ps1",
                "${file}"
            ],
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "echo": false, "reveal": "silent", "panel": "shared", "clear": true }
        }
    ]
}
